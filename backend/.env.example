# ---- LLM (open model from Hugging Face) ----
# local        = run the model on your own PC with Ollama (free, no key)   <- recommended
# huggingface  = Hugging Face Inference API (needs HF_TOKEN; free credit is tiny)
# fake         = no model, template text (testing only)
LLM_PROVIDER=local
LOCAL_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:7b          # use qwen2.5:3b if your PC has 8 GB RAM
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---- Company + e-mail (Gmail) ----
COMPANY_NAME=S.K A.I Development
HR_EMAIL=ankitmodi117@gmail.com
MAIL_FROM=ankitmodi117@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ankitmodi117@gmail.com
# Gmail APP PASSWORD (16 letters), NOT your normal Gmail password.
# Leave empty = emails are only printed in the console (not sent).
SMTP_PASSWORD=

# ---- Business rules ----
MIN_APPLICATIONS=20
SHORTLIST_N=20
OFFER_DEADLINE_DAYS=5
WAIT_SCALE=1.0
EMBEDDINGS=hash

# ---- Accounts / Candidate Dashboard ----
SECRET_KEY=change-this-to-a-long-random-string
HR_INVITE_CODE=SKAI-HR-2026
APPLY_DEADLINE_DAYS=30
MAX_RESUME_MB=5
